{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/(.*)/index.html", "destination": "/$1/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|svg|gif|ico|avif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
